---
import '../styles/global.css';
import { defaultLocale, htmlLang, localeHref, locales, type Locale } from '../i18n/locales';

interface Props {
  title: string;
  description: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;

const canonical = new URL(localeHref(locale), Astro.site);
---

<!doctype html>
<html lang={htmlLang[locale]} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {
      locales.map((alt) => (
        <link
          rel="alternate"
          hreflang={htmlLang[alt]}
          href={new URL(localeHref(alt), Astro.site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localeHref(defaultLocale), Astro.site).href}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // apply the saved theme — or the OS preference, if nothing is saved
      // yet — before first paint, so there is no flash and no defaulting
      // to light on a system set to dark
      (function () {
        const stored = localStorage.getItem('galaxio-theme');
        const theme =
          stored === 'dark' || stored === 'light'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <!-- Reusable brand mark SVG (defs) -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <symbol id="glx-mark" viewBox="0 0 525.68 448.52">
          <path
            fill="currentColor"
            d="M262.32,358.59c-60.91,0-117-40.19-134.48-101.62A139.78,139.78,0,0,1,295.56,83.09,9.24,9.24,0,0,1,291.15,101a121.3,121.3,0,1,0,87.79,84.71,9.24,9.24,0,0,1,17.77-5c21,74.13-22.17,151.54-96.3,172.57A139.47,139.47,0,0,1,262.32,358.59Z"
          ></path>
          <path
            fill="currentColor"
            d="M393.37,191.39l-185.06,122,174.26-137A9.24,9.24,0,0,1,394,190.94Z"></path>
          <path fill="currentColor" d="M381,164.21,72.2,375.41l302.33-220.3a5.57,5.57,0,0,1,6.56,9Z"
          ></path>
          <path
            fill="currentColor"
            d="M442,123.41a55.92,55.92,0,0,1-10.11-7.51c-2.56-2.22-2.59-4-.83-6.92a29.23,29.23,0,0,1,2.56-3.59c8.06-9.65,17.61-17.75,27.07-25.92,4-3.43,8-6.73,12-10.09l-.22-.3-1.08.68,13.67-10.13L462.65,75.24c-13.89,8.6-27.94,16.88-42.58,24.17a46.44,46.44,0,0,1-28,4.62c-18-2.52-35.62-6.75-53.15-11.44-1.4-.38-2.81-.7-4.21-1,11.82,5.71,23.56,11.44,35,17.67a68.87,68.87,0,0,1,11.92,8.9c2.24,2,2.26,3.61.48,6a67,67,0,0,1-8.36,10q-7.55,6.84-15.23,13.56L178,273.33l-.13.09a5.57,5.57,0,0,0,6.63,8.95L358.48,153.46c11.95-7.26,24-14.26,36.65-20.33a41.57,41.57,0,0,1,23.51-4c14.29,1.66,28.27,4.79,42.2,8.2,5.81,1.42,11.58,3,17.37,4.49a20.74,20.74,0,0,0-3.12-1.73C464,134.58,452.9,129.2,442,123.41Z"
          ></path>
        </symbol>
      </defs>
    </svg>
    <slot />
  </body>
</html>
